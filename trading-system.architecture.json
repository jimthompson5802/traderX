{
    "$schema": "https://calm.finos.org/release/1.2/meta/calm.json",
    "unique-id": "trading-system",
    "name": "Trading System",
    "description": "An event-driven trading system architecture supporting order submission, account management, position tracking, and real-time trade updates",
    "metadata": [
        {
            "version": "1.0.0",
            "created-by": "Architecture Team",
            "business-domain": "Capital Markets",
            "architecture-style": "Event-Driven"
        }
    ],
    "controls": {
        "encryption-in-transit": {
            "description": "All data transmitted between system components must be encrypted using TLS 1.3 or higher with modern cipher suites, validated certificates, and mutual TLS recommended for service-to-service communication",
            "requirements": [
                {
                    "requirement-url": "https://schemas.company.com/security/tls-encryption.json",
                    "config": {
                        "protocol": "TLS",
                        "minimum-version": "1.3",
                        "cipher-suites": [
                            "TLS_AES_256_GCM_SHA384",
                            "TLS_CHACHA20_POLY1305_SHA256",
                            "TLS_AES_128_GCM_SHA256"
                        ],
                        "certificate-validation": "required",
                        "mutual-tls-recommended": true,
                        "applies-to": "all inter-component communication"
                    }
                }
            ]
        },
        "encryption-at-rest": {
            "description": "All stored data must be encrypted at rest using AES-256 equivalent encryption with hardware-backed or managed key systems, regular key rotation (every 90 days), applied to databases, file systems, object storage, and backups",
            "requirements": [
                {
                    "requirement-url": "https://schemas.company.com/security/data-encryption.json",
                    "config": {
                        "encryption-algorithm": "AES-256",
                        "key-management": "hardware-backed or managed key system",
                        "key-rotation-period": "90-days",
                        "applies-to": [
                            "databases",
                            "file systems",
                            "object storage",
                            "backups"
                        ],
                        "cipher-modes": [
                            "GCM",
                            "CBC"
                        ]
                    }
                }
            ]
        }
    },
    "nodes": [
        {
            "unique-id": "trader",
            "node-type": "actor",
            "name": "Trader",
            "description": "User who submits trades, manages accounts, and monitors positions through the web interface"
        },
        {
            "unique-id": "web-gui",
            "node-type": "webclient",
            "name": "Web GUI",
            "description": "User interface for submitting trades, viewing positions, managing accounts, and displaying real-time updates"
        },
        {
            "unique-id": "account-service",
            "node-type": "service",
            "name": "Account Service",
            "description": "Manages account creation, updates, user associations, and account inquiries by interfacing with the Trade Data Store",
            "interfaces": [
                {
                    "unique-id": "account-service-api",
                    "interface-type": "api",
                    "protocol": "REST",
                    "data-format": "JSON",
                    "specification": {
                        "endpoints": [
                            {
                                "path": "/account/{id}",
                                "method": "GET",
                                "description": "Retrieve account by ID"
                            },
                            {
                                "path": "/account/",
                                "method": "POST",
                                "description": "Create new account"
                            },
                            {
                                "path": "/account/",
                                "method": "PUT",
                                "description": "Update existing account"
                            },
                            {
                                "path": "/account/",
                                "method": "GET",
                                "description": "Get all accounts"
                            },
                            {
                                "path": "/accountuser/{id}",
                                "method": "GET",
                                "description": "Get account user by ID"
                            },
                            {
                                "path": "/accountuser/",
                                "method": "POST",
                                "description": "Create account user association"
                            },
                            {
                                "path": "/accountuser/",
                                "method": "PUT",
                                "description": "Update account user association"
                            },
                            {
                                "path": "/accountuser/",
                                "method": "GET",
                                "description": "Get all account users"
                            }
                        ],
                        "port": 18088
                    }
                }
            ]
        },
        {
            "unique-id": "trade-service",
            "node-type": "service",
            "name": "Trade Service",
            "description": "Handles trade submission, validates tickers and accounts, and publishes new trade events to the Trade Feed",
            "interfaces": [
                {
                    "unique-id": "trade-service-api",
                    "interface-type": "api",
                    "protocol": "REST",
                    "data-format": "JSON",
                    "specification": {
                        "endpoints": [
                            {
                                "path": "/trade/",
                                "method": "POST",
                                "description": "Submit a new trade order"
                            }
                        ],
                        "port": 18092
                    }
                }
            ]
        },
        {
            "unique-id": "position-service",
            "node-type": "service",
            "name": "Position Service",
            "description": "Provides trade and position data for account blotters by querying the Trade Data Store",
            "interfaces": [
                {
                    "unique-id": "position-service-api",
                    "interface-type": "api",
                    "protocol": "REST",
                    "data-format": "JSON",
                    "specification": {
                        "endpoints": [
                            {
                                "path": "/trades/{accountId}",
                                "method": "GET",
                                "description": "Get trades by account ID"
                            },
                            {
                                "path": "/trades/",
                                "method": "GET",
                                "description": "Get all trades"
                            },
                            {
                                "path": "/positions/{accountId}",
                                "method": "GET",
                                "description": "Get positions by account ID"
                            },
                            {
                                "path": "/positions/",
                                "method": "GET",
                                "description": "Get all positions"
                            },
                            {
                                "path": "/health/ready",
                                "method": "GET",
                                "description": "Health check ready status"
                            },
                            {
                                "path": "/health/alive",
                                "method": "GET",
                                "description": "Health check alive status"
                            }
                        ],
                        "port": 18090
                    }
                }
            ]
        },
        {
            "unique-id": "trade-processor",
            "node-type": "service",
            "name": "Trade Processor",
            "description": "Processes trade events asynchronously, updates trades and positions in the Trade Data Store, and publishes status updates",
            "interfaces": [
                {
                    "unique-id": "trade-processor-api",
                    "interface-type": "api",
                    "protocol": "REST",
                    "data-format": "JSON",
                    "specification": {
                        "endpoints": [
                            {
                                "path": "/tradeservice/order",
                                "method": "POST",
                                "description": "Process trade order"
                            }
                        ],
                        "port": 18091
                    }
                }
            ]
        },
        {
            "unique-id": "security-master",
            "node-type": "service",
            "name": "Security Master",
            "description": "Maintains the list of tradeable securities and company information, loaded from CSV file, used for ticker validation",
            "interfaces": [
                {
                    "unique-id": "security-master-api",
                    "interface-type": "api",
                    "protocol": "REST",
                    "data-format": "JSON",
                    "specification": {
                        "endpoints": [
                            {
                                "path": "/stocks",
                                "method": "GET",
                                "description": "Get all stocks"
                            },
                            {
                                "path": "/stocks/{ticker}",
                                "method": "GET",
                                "description": "Get stock by ticker symbol"
                            },
                            {
                                "path": "/health",
                                "method": "GET",
                                "description": "Health check"
                            }
                        ],
                        "port": 18085
                    }
                }
            ]
        },
        {
            "unique-id": "people-service",
            "node-type": "service",
            "name": "People Service",
            "description": "Provides user search and retrieval from the User Directory for account association workflows",
            "interfaces": [
                {
                    "unique-id": "people-service-api",
                    "interface-type": "api",
                    "protocol": "REST",
                    "data-format": "JSON",
                    "specification": {
                        "endpoints": [
                            {
                                "path": "/People/GetPerson",
                                "method": "GET",
                                "description": "Get a person from directory by logon or employee ID"
                            },
                            {
                                "path": "/People/GetMatchingPeople",
                                "method": "GET",
                                "description": "Get all people whose logonId or full name contain the search text"
                            },
                            {
                                "path": "/People/ValidatePerson",
                                "method": "GET",
                                "description": "Validate a person against the directory"
                            }
                        ],
                        "port": 18089
                    }
                }
            ]
        },
        {
            "unique-id": "trade-data-store",
            "node-type": "database",
            "name": "Trade Data Store",
            "description": "Central repository storing trading accounts, executed trades, positions, and related transactional data"
        },
        {
            "unique-id": "user-directory",
            "node-type": "database",
            "name": "User Directory",
            "description": "Stores user profiles and contact information supporting authentication and search operations"
        },
        {
            "unique-id": "trade-feed",
            "node-type": "service",
            "name": "Trade Feed",
            "description": "Real-time event streaming service publishing trade execution, position updates, and trade status notifications to subscribers",
            "interfaces": [
                {
                    "unique-id": "trade-feed-websocket",
                    "interface-type": "api",
                    "protocol": "WebSocket",
                    "data-format": "JSON",
                    "specification": {
                        "technology": "Socket.IO",
                        "port": 18086,
                        "endpoints": [
                            {
                                "path": "/",
                                "method": "GET",
                                "description": "HTML viewer page for monitoring published messages in real-time"
                            }
                        ],
                        "socket-commands": [
                            {
                                "command": "subscribe",
                                "direction": "client-to-server",
                                "description": "Subscribe to a topic to receive published messages"
                            },
                            {
                                "command": "unsubscribe",
                                "direction": "client-to-server",
                                "description": "Unsubscribe from a topic to stop receiving messages"
                            },
                            {
                                "command": "publish",
                                "direction": "bidirectional",
                                "description": "Publish a message to a topic; server also emits this event to subscribers"
                            }
                        ],
                        "topics": [
                            {
                                "pattern": "/trades",
                                "description": "Trade order events for processing"
                            },
                            {
                                "pattern": "/accounts/{accountId}/trades",
                                "description": "Account-specific trade events"
                            },
                            {
                                "pattern": "/accounts/{accountId}/positions",
                                "description": "Account-specific position updates"
                            },
                            {
                                "pattern": "/*",
                                "description": "Global wildcard topic for monitoring all traffic"
                            }
                        ]
                    }
                }
            ]
        }
    ],
    "relationships": [
        {
            "unique-id": "trader-to-web-gui",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "trader"
                    },
                    "destination": {
                        "node": "web-gui"
                    }
                }
            },
            "description": "Trader interacts with Web GUI to submit trades, view positions, and manage accounts",
            "parties": ["trader", "web-gui"]
        },
        {
            "unique-id": "web-gui-to-account-service",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "web-gui"
                    },
                    "destination": {
                        "node": "account-service"
                    }
                }
            },
            "description": "Web GUI requests account list, creates/updates accounts, and manages user associations",
            "parties": ["web-gui", "account-service"]
        },
        {
            "unique-id": "web-gui-to-position-service",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "web-gui"
                    },
                    "destination": {
                        "node": "position-service"
                    }
                }
            },
            "description": "Web GUI requests trades and positions for selected account to initialize blotter",
            "parties": ["web-gui", "position-service"]
        },
        {
            "unique-id": "web-gui-to-security-master",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "web-gui"
                    },
                    "destination": {
                        "node": "security-master"
                    }
                }
            },
            "description": "Web GUI retrieves list of valid tickers for trade submission",
            "parties": ["web-gui", "security-master"]
        },
        {
            "unique-id": "web-gui-to-trade-service",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "web-gui"
                    },
                    "destination": {
                        "node": "trade-service"
                    }
                }
            },
            "description": "Web GUI submits trade requests containing account, ticker, side, and quantity",
            "parties": ["web-gui", "trade-service"]
        },
        {
            "unique-id": "web-gui-to-people-service",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "web-gui"
                    },
                    "destination": {
                        "node": "people-service"
                    }
                }
            },
            "description": "Web GUI searches for users to associate with accounts",
            "parties": ["web-gui", "people-service"]
        },
        {
            "unique-id": "web-gui-to-trade-feed",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "web-gui"
                    },
                    "destination": {
                        "node": "trade-feed"
                    }
                }
            },
            "description": "Web GUI subscribes to Trade Feed for live trade and position updates",
            "parties": ["web-gui", "trade-feed"]
        },
        {
            "unique-id": "trade-service-to-security-master",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "trade-service"
                    },
                    "destination": {
                        "node": "security-master"
                    }
                }
            },
            "description": "Trade Service validates ticker symbols before processing trade requests",
            "parties": ["trade-service", "security-master"]
        },
        {
            "unique-id": "trade-service-to-account-service",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "trade-service"
                    },
                    "destination": {
                        "node": "account-service"
                    }
                }
            },
            "description": "Trade Service validates account existence before processing trade requests",
            "parties": ["trade-service", "account-service"]
        },
        {
            "unique-id": "trade-service-to-trade-feed",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "trade-service"
                    },
                    "destination": {
                        "node": "trade-feed"
                    }
                }
            },
            "description": "Trade Service publishes new trade events after validation",
            "parties": ["trade-service", "trade-feed"]
        },
        {
            "unique-id": "account-service-to-trade-data-store",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "account-service"
                    },
                    "destination": {
                        "node": "trade-data-store"
                    }
                }
            },
            "description": "Account Service queries and writes account data and account-user mappings",
            "parties": ["account-service", "trade-data-store"]
        },
        {
            "unique-id": "position-service-to-trade-data-store",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "position-service"
                    },
                    "destination": {
                        "node": "trade-data-store"
                    }
                }
            },
            "description": "Position Service queries trades and positions for account blotters",
            "parties": ["position-service", "trade-data-store"]
        },
        {
            "unique-id": "people-service-to-user-directory",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "people-service"
                    },
                    "destination": {
                        "node": "user-directory"
                    }
                }
            },
            "description": "People Service queries user profiles for search and retrieval operations",
            "parties": ["people-service", "user-directory"]
        },
        {
            "unique-id": "trade-processor-to-trade-feed-subscribe",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "trade-processor"
                    },
                    "destination": {
                        "node": "trade-feed"
                    }
                }
            },
            "description": "Trade Processor receives new trade events from Trade Feed for processing",
            "parties": ["trade-processor", "trade-feed"]
        },
        {
            "unique-id": "trade-processor-to-trade-data-store",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "trade-processor"
                    },
                    "destination": {
                        "node": "trade-data-store"
                    }
                }
            },
            "description": "Trade Processor inserts trades and updates positions in the Trade Data Store",
            "parties": ["trade-processor", "trade-data-store"]
        },
        {
            "unique-id": "trade-processor-to-trade-feed-publish",
            "relationship-type": {
                "connects": {
                    "source": {
                        "node": "trade-processor"
                    },
                    "destination": {
                        "node": "trade-feed"
                    }
                }
            },
            "description": "Trade Processor publishes account-specific trade events and position updates",
            "parties": ["trade-processor", "trade-feed"]
        }
    ],
    "flows": [
        {
            "unique-id": "load-account-list-flow",
            "name": "Load List of Accounts",
            "description": "Web GUI requests and displays the list of all trading accounts",
            "transitions": [
                {
                    "relationship-unique-id": "web-gui-to-account-service",
                    "sequence-number": 1,
                    "description": "Web GUI requests account list from Account Service",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "account-service-to-trade-data-store",
                    "sequence-number": 2,
                    "description": "Account Service queries Trade Data Store for all accounts",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "account-service-to-trade-data-store",
                    "sequence-number": 3,
                    "description": "Trade Data Store returns account list to Account Service",
                    "direction": "destination-to-source"
                },
                {
                    "relationship-unique-id": "web-gui-to-account-service",
                    "sequence-number": 4,
                    "description": "Account Service returns account list to Web GUI for display",
                    "direction": "destination-to-source"
                }
            ]
        },
        {
            "unique-id": "bootstrap-blotter-flow",
            "name": "Bootstrapping the Trade and Position Blotter",
            "description": "Initialize the blotter with historical data and subscribe to real-time updates",
            "transitions": [
                {
                    "relationship-unique-id": "web-gui-to-position-service",
                    "sequence-number": 1,
                    "description": "Web GUI requests trades and positions for selected account",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "position-service-to-trade-data-store",
                    "sequence-number": 2,
                    "description": "Position Service queries Trade Data Store",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "position-service-to-trade-data-store",
                    "sequence-number": 3,
                    "description": "Trade Data Store returns initial dataset",
                    "direction": "destination-to-source"
                },
                {
                    "relationship-unique-id": "web-gui-to-position-service",
                    "sequence-number": 4,
                    "description": "Position Service returns initial data to Web GUI",
                    "direction": "destination-to-source"
                },
                {
                    "relationship-unique-id": "web-gui-to-trade-feed",
                    "sequence-number": 5,
                    "description": "Web GUI subscribes to Trade Feed for live updates",
                    "direction": "source-to-destination"
                }
            ]
        },
        {
            "unique-id": "submit-trade-ticket-flow",
            "name": "Submitting a Trade Ticket",
            "description": "Trader submits a trade order through Web GUI with validation and event publication",
            "transitions": [
                {
                    "relationship-unique-id": "trader-to-web-gui",
                    "sequence-number": 1,
                    "description": "Trader initiates trade submission through Web GUI",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "web-gui-to-security-master",
                    "sequence-number": 2,
                    "description": "Web GUI retrieves valid tickers from Security Master",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "web-gui-to-trade-service",
                    "sequence-number": 3,
                    "description": "Trader submits trade request with account, ticker, side, and quantity",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "trade-service-to-security-master",
                    "sequence-number": 4,
                    "description": "Trade Service validates ticker with Security Master",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "trade-service-to-account-service",
                    "sequence-number": 5,
                    "description": "Trade Service validates account with Account Service",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "trade-service-to-trade-feed",
                    "sequence-number": 6,
                    "description": "Trade Service publishes new trade event to Trade Feed",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "web-gui-to-trade-service",
                    "sequence-number": 7,
                    "description": "Trade Service returns completion response to Web GUI",
                    "direction": "destination-to-source"
                },
                {
                    "relationship-unique-id": "trader-to-web-gui",
                    "sequence-number": 8,
                    "description": "Web GUI confirms trade submission to Trader",
                    "direction": "destination-to-source"
                }
            ]
        },
        {
            "unique-id": "trade-processing-flow",
            "name": "Trade Processing",
            "description": "Asynchronous processing of trade events through execution and position updates with Trader notification",
            "transitions": [
                {
                    "relationship-unique-id": "trade-processor-to-trade-feed-subscribe",
                    "sequence-number": 1,
                    "description": "Trade Feed delivers new trade event to Trade Processor",
                    "direction": "destination-to-source"
                },
                {
                    "relationship-unique-id": "trade-processor-to-trade-data-store",
                    "sequence-number": 2,
                    "description": "Trade Processor inserts trade into Trade Data Store",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "trade-processor-to-trade-feed-publish",
                    "sequence-number": 3,
                    "description": "Trade Processor publishes account-specific trade event",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "web-gui-to-trade-feed",
                    "sequence-number": 4,
                    "description": "Web GUI receives trade event through Trade Feed",
                    "direction": "destination-to-source"
                },
                {
                    "relationship-unique-id": "trade-processor-to-trade-data-store",
                    "sequence-number": 5,
                    "description": "Trade Processor marks trade as executed and updates position",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "trade-processor-to-trade-feed-publish",
                    "sequence-number": 6,
                    "description": "Trade Processor publishes trade and position updates",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "web-gui-to-trade-feed",
                    "sequence-number": 7,
                    "description": "Web GUI receives updates through Trade Feed",
                    "direction": "destination-to-source"
                },
                {
                    "relationship-unique-id": "trader-to-web-gui",
                    "sequence-number": 8,
                    "description": "Trader receives trade and position update notifications from Web GUI",
                    "direction": "destination-to-source"
                }
            ]
        },
        {
            "unique-id": "add-update-account-flow",
            "name": "Add or Update Account",
            "description": "Create new account or modify existing account information",
            "transitions": [
                {
                    "relationship-unique-id": "web-gui-to-account-service",
                    "sequence-number": 1,
                    "description": "Web GUI sends account creation or update request",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "account-service-to-trade-data-store",
                    "sequence-number": 2,
                    "description": "Account Service writes account information to Trade Data Store",
                    "direction": "source-to-destination"
                },
                {
                    "relationship-unique-id": "web-gui-to-account-service",
                    "sequence-number": 3,
                    "description": "Account Service returns success or failure response",
                    "direction": "destination-to-source"
                }
            ]
        },
        {
            "unique-id": "add-users-to-account-flow",
            "name": "Add or Update Users to Account",
            "description": "Associate users with trading accounts for access management",
            "transitions": [
                {
                    "relationship-unique-id": "web-gui-to-account-service",
                    "sequence-number": 1,
                    "description": "Web GUI retrieves current list of associated people",
                    "direction": "source-to-destination"
                },
                {
